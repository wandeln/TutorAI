# ─── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ─── Datenbank ──────────────────────────────────────────────────
# SQLite (Default)
DATABASE_URL=sqlite:///data/tutor.db
# Oder PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/tutor_db

# ─── Auth / JWT ─────────────────────────────────────────────────
# ⚠️ In Production: Zufälligen, langen Key verwenden!
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── LLM / OpenAI-kompatibler Endpoint ──────────────────────────
# Beispiel Uni-Server mit Qwen:
LLM_API_URL=http://llm-server.uni.de:8001/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=Qwen3-32B
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ─── LDAP (optional) ───────────────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldap.uni.de
LDAP_BASE_DN=ou=people,dc=uni,dc=de
LDAP_BIND_DN=cn=admin,dc=uni,dc=de
LDAP_BIND_PW=
LDAP_USER_SEARCH=(uid={username})

# ─── Sandbox / Code-Ausführung ──────────────────────────────────
SANDBOX_TIMEOUT=15
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_SECONDS=30