# AICampus Compute-Agent — systemd-Unit (nativ auf einem Compute-Server
# ODER auf dem AICampus-Server selbst für den Hybrid-Betrieb).
#
# Installation (als root, REPO=/opt/aicampus/repo anpassen):
#   cp deploy/aicampus-compute-agent.service /etc/systemd/system/
#   cp deploy/compute-agent.env.example /etc/aicampus/compute-agent.env
#   chmod 600 /etc/aicampus/compute-agent.env
#   systemctl daemon-reload && systemctl enable --now aicampus-compute-agent
#
# Der Agent bindet standardmäßig NUR auf 127.0.0.1:8700. Von AICampus aus
# wird er über einen SSH-Tunnel erreichbar (deploy/aicampus-compute-tunnel.service).

[Unit]
Description=AICampus Compute Agent (Workspace-Container-Manager)
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
User=aicampus
Group=aicampus
WorkingDirectory=/opt/aicampus/repo
EnvironmentFile=/etc/aicampus/compute-agent.env
ExecStart=/opt/aicampus/venv/bin/python -m compute_agent
Restart=always
RestartSec=5

# Härten
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/aicampus/assets
# docker.sock wird via User/Group-Rechte des Hosts bedient
ProtectHome=true

[Install]
WantedBy=multi-user.target
