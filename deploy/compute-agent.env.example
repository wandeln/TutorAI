# /etc/tutorai/compute-agent.env — Konfiguration des Compute-Agenten
# (von tutorai-compute-agent.service gelesen; chmod 600!)

# Gemeinsamer HMAC-Secret mit TutorAI (dort: COMPUTE_AGENT_KEY im .env).
# LEER = Auth deaktiviert (NUR für lokale Entwicklung!)
AGENT_KEY=WECHSELE-DICH-IN-EINEN-LANGEN-ZUFAELLENGEN-SKRIPT-KEY

# Port (Standard 8700). Bei mehreren Agenten auf einem Host: 8701, 8702, …
AGENT_PORT=8700

# Verzeichnis für geteilte Assets (Daten, Tests, Task-Skripte) je Aufgabe
ASSET_ROOT=/opt/tutorai/assets

# Idle-Timeout für Workspace-Container (Sekunden; Volume bleibt erhalten)
IDLE_TIMEOUT=1200

# Timeout für den init.sh-Build (Sekunden; Default 1800 = 30 min)
# AGENT_INIT_TIMEOUT=1800

# Max. parallele GPU-Jobs auf diesem Node (FIFO-Queue).
# Die GPU soll bewusst NICHT voll ausgelastet werden.
GPU_MAX_JOBS=8

# GPU: auto (nvidia-smi-Check) | true (erzwungen) | false (deaktiviert)
GPU_ENABLED=auto
