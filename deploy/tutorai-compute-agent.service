# TutorAI Compute-Agent — systemd-Unit (nativ auf einem Compute-Server
# ODER auf dem TutorAI-Server selbst für den Hybrid-Betrieb).
#
# Installation (als root, REPO=/opt/tutorai/repo anpassen):
#   cp deploy/tutorai-compute-agent.service /etc/systemd/system/
#   cp deploy/compute-agent.env.example /etc/tutorai/compute-agent.env
#   chmod 600 /etc/tutorai/compute-agent.env
#   systemctl daemon-reload && systemctl enable --now tutorai-compute-agent
#
# Der Agent bindet standardmäßig NUR auf 127.0.0.1:8700. Von TutorAI aus
# wird er über einen SSH-Tunnel erreichbar (deploy/tutorai-compute-tunnel.service).

[Unit]
Description=TutorAI Compute Agent (Workspace-Container-Manager)
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
User=tutorai
Group=tutorai
WorkingDirectory=/opt/tutorai/repo
EnvironmentFile=/etc/tutorai/compute-agent.env
ExecStart=/opt/tutorai/venv/bin/python -m compute_agent
Restart=always
RestartSec=5

# Härten
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/tutorai/assets
# docker.sock wird via User/Group-Rechte des Hosts bedient
ProtectHome=true

[Install]
WantedBy=multi-user.target
